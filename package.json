{
  "name": "exness",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate": "pnpm --filter @repo/prisma migrate:deploy",
    "dev:api": "pnpm --filter api-service dev",
    "dev:engine": "pnpm --filter engine-service dev",
    "dev:price-poller": "pnpm --filter price-poller-service dev",
    "dev:web": "pnpm --filter web dev",
    "start": "bash scripts/start.sh"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
