generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  password     String
  name         String
  createdAt    DateTime      @default(now())
  assets       Asset[]
  orders       Order[]
  transactions Transaction[]
}

model Asset {
  id      String  @id @default(uuid()) @db.Uuid
  symbol  Symbol
  balance Decimal @db.Decimal(24, 8)
  userId  String  @db.Uuid
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, symbol], name: "user_symbol_unique")
}

model Order {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  asset        Symbol       @default(BTC)
  side         Side
  qty          Decimal      @db.Decimal(24, 8)
  leverage     Int          @default(1)
  openingPrice Decimal      @db.Decimal(24, 8)
  closingPrice Decimal?     @db.Decimal(24, 8)
  margin       Decimal      @db.Decimal(24, 8)
  pnl          Decimal      @default(0) @db.Decimal(24, 8)
  takeProfit   Decimal?     @db.Decimal(24, 8)
  stopLoss     Decimal?     @db.Decimal(24, 8)
  status       OrderStatus
  closeReason  CloseReason?
  createdAt    DateTime     @default(now())
  closedAt     DateTime?
  User         User         @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Transaction {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  type         TransactionType
  symbol       Symbol
  amount       Decimal         @db.Decimal(24, 8)
  balanceAfter Decimal         @db.Decimal(24, 8)
  orderId      String?         @db.Uuid
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum Symbol {
  USDC
  BTC
  ETH
  SOL
}

enum Side {
  long
  short
}

enum OrderStatus {
  open
  closed
}

enum CloseReason {
  TakeProfit
  StopLoss
  Manual
  Liquidation
}

enum TransactionType {
  Deposit
  RealizedPnl
}
