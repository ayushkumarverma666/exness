# Copy to apps/<service>/.env for local development (each service loads its own .env).
DATABASE_URL=postgresql://app:app@localhost:5432/trading
REDIS_HOST=127.0.0.1
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
# Use a synthetic price feed when the exchange is unreachable (development only).
# PRICE_FEED=simulated
# Only needed when the web app is served from a different domain than the API:
# CORS_ORIGINS=https://your-web-app.vercel.app
# COOKIE_SAMESITE=none
